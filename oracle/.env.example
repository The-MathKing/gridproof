# Copy to oracle/.env (never committed) to run the oracle on Sepolia.
GRIDPROOF_NETWORK=sepolia
# Your RPC endpoint (Alchemy/Infura free tier), or the public one:
GRIDPROOF_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The SAME test wallet you deployed the contracts with. Use a wallet made only for this.
GRIDPROOF_PRIVATE_KEY=
